datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("ADMIN") // ADMIN, STAFF, EMPLOYEE
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id           String    @id @default(cuid())
  name         String
  slug         String    @unique
  description  String?
  image        String?
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  products     Product[]
}

model Product {
  id            String           @id @default(cuid())
  name          String
  slug          String           @unique
  description   String
  categoryId    String
  category      Category         @relation(fields: [categoryId], references: [id])
  sku           String           @unique
  sellingPrice  Float
  originalPrice Float?
  status        String           @default("DRAFT") // DRAFT, PUBLISHED
  isFeatured    Boolean          @default(false)
  isNewArrival  Boolean          @default(false)
  mainImage     String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  images        ProductImage[]
  variants      ProductVariant[]
  orderItems    OrderItem[]
}

model ProductImage {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url          String
  colour       String?  // Associated colour tag (e.g. "Black", "Maroon")
  displayOrder Int      @default(0)
  isMain       Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  colour     String
  colourCode String?  @default("#1E293B")
  size       String
  stock      Int      @default(0)
  price      Float?
  sku        String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  customerName    String
  customerPhone   String
  deliveryAddress String
  city            String?     @default("")
  postalCode      String?
  notes           String?
  internalNotes   String?
  subtotal        Float
  shippingCharge  Float
  total           Float
  status          String      @default("PENDING") // PENDING, CONFIRMED, PROCESSING, SHIPPED, DELIVERED, CANCELLED
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           OrderItem[]
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName  String
  productImage String?
  sku          String?
  colour       String
  size         String
  quantity     Int
  unitPrice    Float
  totalPrice   Float
}

model StoreSettings {
  id                    String   @id @default("default")
  businessName          String   @default("The Premiums Society")
  storeLogo             String?  @default("/images/logo.png")
  primaryPhone          String   @default("+919920517851")
  secondaryPhone        String?  @default("+919920517851")
  defaultRecipient      String   @default("primary")
  businessEmail         String   @default("contact@thepremiums.in")
  shippingCharge        Float    @default(100)
  freeShippingThreshold Float?   @default(2000)
  currency              String   @default("INR")
  currencySymbol        String   @default("₹")
  storeAnnouncement     String?  @default("Special Festive Offer: FREE Delivery on orders over ₹2000 across India!")
  announcementActive    Boolean  @default(true)
  facebookUrl           String?
  instagramUrl          String?  @default("https://www.instagram.com/the_premiumss?xtok=MXBtOTNoc2tiM3RxMg==")
  whatsappUrl           String?  @default("https://wa.me/919920517851")
  address               String?
  updatedAt             DateTime @updatedAt
}

model WebsiteContent {
  id                  String   @id @default("default")
  heroHeading         String   @default("The Premiums Society — Timeless Luxury & Elegance")
  heroSubheading      String   @default("Discover the latest hand-crafted traditional & contemporary clothing collection tailored for perfection.")
  heroImage           String?  @default("/uploads/hero-fashion.jpg")
  heroPrimaryBtnText  String   @default("Shop New Arrivals")
  heroPrimaryBtnLink  String   @default("/shop?filter=new")
  heroSecondaryBtnText String  @default("Explore Categories")
  heroSecondaryBtnLink String  @default("/#categories")
  announcementBar     String?  @default("✨ Special Festive Offer: FREE Delivery on orders over ₹2000 across India!")
  brandStoryTitle     String   @default("Authentic Craftsmanship & Modern Elegance")
  brandStoryText      String   @default("At The Premiums Society, we blend heritage needlework with contemporary silhouettes. From everyday comfort to bespoke celebratory attire, every stitch represents premium craftsmanship, finest organic fabrics, and unmatched attention to detail.")
  brandStoryImage     String?  @default("/uploads/brand-story.jpg")
  updatedAt           DateTime @updatedAt
}

model Policy {
  id        String   @id
  title     String
  slug      String   @unique
  content   String
  updatedAt DateTime @updatedAt
}
